{
  "name": "ctx-autopsy",
  "version": "0.2.4",
  "description": "Post-mortem for dead agent sessions: read a saved LLM request body or session log and see where the tokens went and why it died. No proxy, no replay.",
  "type": "module",
  "bin": {
    "ctx-autopsy": "src/cli.js"
  },
  "scripts": {
    "test": "node test/run.js",
    "selftest": "node src/cli.js --selftest"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "llm",
    "context-window",
    "agent",
    "forensics",
    "tokens",
    "debugging",
    "postmortem"
  ],
  "license": "MIT",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ]
}
